    "es": ["agarr", "cog", "coj", "recog", "recoj", "tom", "traer", "trae", "traig", "traj", "llev", "pon", "coloc",
           "mete", "meter", "met", "insert", "naveg", "muev", "mov", "busc", "mira", "mirar", "inspeccion", "revis",
           "explor", "dej", "suelt", "solt", "abre", "abrir", "abr", "cierr", "cerr", "entreg", "dame", "transport",
           "percib", "ve", "vete", "ir", "vay", "ven", "sube", "baja", "levant"],
    "de": ["greif", "nehm", "nimm", "bring", "hol", "stell", "leg", "steck", "fahr", "geh", "such", "schau",
           "prüf", "öffn", "schließ", "gib", "transport", "heb", "trag", "komm", "navigier",
           "inspizier", "untersuch"],
}
_EN_ENDINGS = r"(s|es|ed|ing|d)?"
_DE_PREFIX = r"(her|hin|ab|auf|an|mit|zurück|weg|rein|raus|hoch|runter|ein|vorbei|hinüber|herüber)?"
_SHORT_EXACT = {"ve", "ir", "ven", "dame", "pon", "mira", "mete", "abre", "trae", "sube", "baja", "vete", "tom",
                "met", "abr", "cog", "coj", "mov", "hol", "leg", "geh", "gib", "heb", "go", "put"}
ACTION_RE = {
    "en": re.compile(r"^(" + "|".join(ACTION_STEMS["en"]) + ")" + _EN_ENDINGS + "$"),
    "es": re.compile(r"^(" + "|".join(sorted(set(ACTION_STEMS["es"]) - _SHORT_EXACT, key=len, reverse=True))
                     + r")\w*$|^(ve|ir|ven|dame|pon|ponla|ponlo|mira|mete|abre|trae|sube|baja|vete|toma|tomar|"
                       r"coge|coger|cojas|mueve|mover|abrir)$"),
    "de": re.compile(r"^" + _DE_PREFIX + "(" + "|".join(ACTION_STEMS["de"]) + r")\w*$"),
}
# a few very common words per language, to tell which one the person speaks
LANGUAGE_WORDS = {
    "en": {"the", "a", "and", "is", "to", "of", "you", "i", "it", "what", "please", "table", "can", "do", "on",
           "in", "my", "your", "this", "that", "are", "with", "from", "where", "who", "how"},
    "es": {"el", "la", "los", "las", "de", "del", "que", "y", "en", "es", "un", "una", "por", "con", "mesa",
           "qué", "cómo", "dónde", "quién", "hola", "quiero", "puedes", "al", "lo", "me", "mí", "te", "tu",
           "español", "hablar", "hablamos", "sí", "pero", "muy", "está"},
    "de": {"der", "die", "das", "und", "ist", "nicht", "ich", "du", "bitte", "zum", "zur", "den", "dem", "ein",
           "eine", "mit", "auf", "tisch", "hallo", "wir", "sprechen", "deutsch", "kannst", "wo", "wer", "was"},
}
# #176: common words that are no English words, so an utterance without any English word but with these is foreign
# (with --languages en "Sind Sie located?" scored nothing and passed as English); not "ya" (a transcribed "yeah")
LANGUAGE_WORDS["de"] |= {"sind", "sie", "bist", "bin", "haben", "hat", "wie", "wann", "warum", "noch", "schon", "auch",
                         "nein", "ja", "gut", "mein", "dein", "wir", "uns", "kein", "keine", "mal", "manchmal",
                         "jetzt", "hier", "dort", "danke", "gerne", "sehr", "doch", "oder", "aber", "nur"}
LANGUAGE_WORDS["es"] |= {"yo", "usted", "eso", "esto", "aquí", "allí", "gracias", "bien", "también", "ahora", "hay",
                         "soy", "estoy", "tengo", "puedo", "vamos", "grupo", "bueno", "nada", "nosotros"}
LANGUAGE_WORDS["it"] = {"il", "lo", "gli", "le", "di", "che", "e", "è", "per", "con", "tavolo", "ciao", "voglio",
                        "puoi", "dove", "cosa", "come", "questo", "quello", "non", "sono", "della", "nel"}
LANGUAGE_WORDS["fr"] = {"le", "la", "les", "de", "des", "du", "et", "est", "un", "une", "pour", "avec", "table",
                        "bonjour", "je", "tu", "vous", "où", "quoi", "comment", "ce", "cette", "pas", "sur", "moi",
                        "toi", "oui", "non", "merci", "très", "voilà"}
LANGUAGE_NAMES = {"en": "English", "es": "Spanish", "de": "German", "it": "Italian", "fr": "French"}
# --languages: the languages the demo accepts. Utterances confidently in another language, or in a non-Latin
# script (noise often comes back as Chinese or Russian), are dropped instead of reaching the agents.
LANGUAGE_SETS = {"en": ["en"], "en,de,es": ["en", "de", "es"], "en,de,es,it,fr": ["en", "de", "es", "it", "fr"]}
NON_LATIN_RE = re.compile(r"[\u0370-\u03ff\u0400-\u04ff\u0590-\u06ff\u0900-\u0dff\u3040-\u30ff\u3400-\u9fff\uac00-\ud7af]")
# the bridge's own sentences, per language (its words, not the person's). The order is read back as a short
# question ("Pick the Pringles?"): a long "Did you say ...?" gave room talk time to cut it off.
PHRASES = {
    "en": {"confirm": "{}?", "yes": "Okay.", "no": "Okay, I ignore it."},
    "es": {"confirm": "¿{}?", "yes": "Vale.", "no": "Vale, lo ignoro."},
    "de": {"confirm": "{}?", "yes": "Okay.", "no": "Okay, ich ignoriere es."},
    "it": {"confirm": "{}?", "yes": "Va bene.", "no": "Va bene, lo ignoro."},
    "fr": {"confirm": "{} ?", "yes": "D'accord.", "no": "D'accord, je l'ignore."},
}
# An order waits for its yes until the person had CONFIRM_REPLY_S of quiet after the robot's last sentence (the
# question, or whatever it said after it), and at most CONFIRM_MAX_S after the order; other talk keeps it waiting.
CONFIRM_REPLY_S = 15.0
CONFIRM_MAX_S = 60.0
# a mic that delivers only zeros (the ALU1's mute button, #189): said aloud at most this often, since the button may
# also be used on purpose against room talk
DEAD_MIC_SENTENCE = "My microphone is muted or not delivering sound, so I cannot hear you."
DEAD_MIC_SAY_EVERY_S = 300.0
MIC_OK_EVERY_S = 10.0  # /realtime/mic_ok is repeated this often for late subscribers
# the API ends every session after 60 minutes (#186): a new one is opened, waiting this long before each further try
RECONNECT_WAIT_S = (0.0, 2.0, 5.0, 10.0, 30.0)
# #25: a session that stays open but sends nothing any more is probed with a session.update; no answer in this time
# closes it and a new one is opened like after the 60 min limit
WATCHDOG_PROBE_S = 15.0
ANSWER_WINDOW_S = 40.0  # a question of the agents stays open this long for one-word answers


def words_of(text: str) -> "list[str]":
    return [w.lower() for w in re.findall(r"[A-Za-zÀ-ÖØ-öø-ÿ0-9']+", text)]


def is_speech(text: str) -> bool:
    """Words worth passing on, not noise transcribed as filler or a stray script."""
    words = re.findall(r"[A-Za-zÀ-ÖØ-öø-ÿ']+", text)
    return bool(words) and not all(w.lower() in FILLER for w in words)


def overlaps(text: str, reference: str, share: float = 0.7, min_words: int = 3) -> bool:
    """Most words of ``text`` come from ``reference`` (a leaked prompt)."""
    words = words_of(text)
    ref = set(words_of(reference))
    return len(words) >= min_words and sum(w in ref for w in words) >= share * len(words)


def echoes(text: str, said: str, share: float = 0.8, min_words: int = 3) -> bool:
    """Most words of ``text`` are the robot's sentence ``said``, in its order (its voice leaking in).

    Order matters: "Pick the Pringles." answering "... with the Pringles.
    Should I pick them up ...?" reuses its words but is the person's own.
    """
    words, ref = words_of(text), words_of(said)
    if len(words) < min_words:
        return False
    common = [0] * (len(ref) + 1)  # longest common subsequence, row by row
    for w in words:
        row = [0]
        for j, r in enumerate(ref):
            row.append(common[j] + 1 if w == r else max(common[j + 1], row[j]))
        common = row
    return common[-1] >= share * len(words)


# "switch to German", "habla español", "sprich Englisch": asked for in any language
SWITCH_RE = re.compile(r"\b(switch|speak|talk|change|use|answer|reply|habla|hablar|cambia|usa|responde|"
                       r"sprich|sprechen|wechsel|antworte|parla|parlare|parle|parlez)\w*\b")
TARGET_LANGUAGE = {"english": "en", "inglés": "en", "ingles": "en", "englisch": "en",
                   "spanish": "es", "español": "es", "espanol": "es", "castellano": "es", "spanisch": "es",
                   "german": "de", "alemán": "de", "aleman": "de", "deutsch": "de",
                   "italian": "it", "italiano": "it", "italienisch": "it", "french": "fr", "français": "fr",
                   "francais": "fr", "französisch": "fr", "francés": "fr"}


def requested_language(text: str) -> str:
    """The language the person asks the robot to speak, or ''."""
    words = words_of(text)
    if not SWITCH_RE.search(" ".join(words)):
        return ""
    targets = [TARGET_LANGUAGE[w] for w in words if w in TARGET_LANGUAGE]
    return targets[-1] if targets else ""


def detect_language(text: str, current: str = "en") -> str:
    """'en', 'es', 'de', 'it' or 'fr' by common words; ``current`` when the words do not tell."""
    words = words_of(text)
    scores = {lang: sum(w in common or bool(lang in ACTION_RE and ACTION_RE[lang].match(w)) for w in words)
              for lang, common in LANGUAGE_WORDS.items()}
    if re.search(r"[ñ¿¡áéíóú]", text):
        scores["es"] += 2
    if re.search(r"[äöüß]", text):
        scores["de"] += 2
    best = max(scores, key=scores.get)
    if scores[best] >= 2 and list(scores.values()).count(scores[best]) == 1:
        return best
    return current


def foreign_only(text: str) -> str:
    """The other language of an utterance without a single English word but with a common word of another
    language ("Sind Sie located?" -> "de"), else "" (#176: with only English allowed it is dropped)."""
    words = words_of(text)
    if any(w in LANGUAGE_WORDS["en"] or ACTION_RE["en"].match(w) for w in words):
        return ""
    scores = {lang: sum(w in common for w in words) for lang, common in LANGUAGE_WORDS.items() if lang != "en"}
    best = max(scores, key=scores.get)
    return best if scores[best] >= 1 else ""


def is_command(text: str, language: str = "en") -> bool:
    """An order for the robot, as opposed to chat, a question about it or an answer.

    Verbs of every language count, except English ones inside a Spanish or
    German utterance: a Spanish sentence with a misheard "pick" is not an order.
    """
    patterns = [r for lang, r in ACTION_RE.items() if lang != "en" or language == "en"]
    return any(r.match(w) for w in words_of(text) for r in patterns)


ENGLISH_STOPS = {"stop", "stopped", "stopping", "cancel", "cancelled", "canceled", "abort", "halt", "freeze"}


# stop words that are also everyday words ("para" = for, "alto" = high): a stop only in a short phrase
AMBIGUOUS_STOPS = {"para", "alto"}


def is_stop(text: str) -> bool:
    """A stop: a leading stop word at any length ("Cancel the inspection on table three", #53; the planner runner
    hard-stops on the same rule since mobipick_gpt c6a4599), or a stop word first or last in at most 4 words."""
    words = words_of(text)
    if not words:
        return False
    if STOP_RE.match(words[0]) and words[0] not in AMBIGUOUS_STOPS:
        return True
    return len(words) <= 4 and bool(STOP_RE.match(words[0]) or STOP_RE.match(words[-1]))


def as_command(text: str) -> str:
    """The order as read back: without a leading "yes," and without end punctuation."""
    text = re.sub(r"^\W*(yes|yeah|ok|okay|sí|si|vale|claro|ja|genau|also)\b[\s,.!]*", "", text.strip(), flags=re.I)
    return re.sub(r"[\s.!?¿¡,;:]+$", "", text).strip() or text.strip()


LEAD_RE = re.compile(r"^\W*((yes|yeah|ok|okay|sí|si|vale|claro|ja|genau|also|so|now|well|alright|and|then|ahora|pues|"
                     r"jetzt|und|dann)\b[\s,.!]*)+", re.I)


def read_back(order: str, language: str = "en") -> str:
    """The order as the robot asks it back: from its first sentence with an action verb, without a lead-in.

    "thank you very much. Now pick the Pringles" -> "Pick the Pringles". The
    whole order is still what goes on after the yes (an earlier sentence may
    name the object: "The red cup. Bring it to me.").
    """
    sentences = re.split(r"(?<=[.!?…])\s+", order.strip())
    start = next((i for i, part in enumerate(sentences) if is_command(part, language)), 0)
    short = " ".join(sentences[start:])
    short = LEAD_RE.sub("", short).strip() or short
    return short[:1].upper() + short[1:]


def yes_or_no(text: str) -> "tuple[str, str]":
    """('yes' | 'no' | '', rest): a short yes, a no with an optional correction, or neither."""
    words = words_of(text)
    if words and words[0] in NO_WORDS:
        rest = re.sub(r"^\W*(no+|nope|nah|wrong|negative|incorrect|not|nein|falsch|incorrecto)\b[\s,.!-]*", "",
                      text.strip(), flags=re.I)
        return "no", rest
    if len(words) == 1 and words[0] in WEAK_YES:
        return "", text
    if words and (words[0] in SURE_YES or len(words) <= 4 and all(w in YES_WORDS for w in words)):
        rest = re.sub(r"^\W*\w+\b[\s,.!]*", "", text.strip()) if words[0] in SURE_YES else ""
        return "yes", rest
    return "", text


def parse_args() -> argparse.Namespace:
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    add_api_args(p)
    add_audio_args(p)
    ros = p.add_argument_group("ros")
    ros.add_argument("--rosbridge-url", default=rosbridge_url())
    ros.add_argument("--goal-topic", default="/recognized_speech")
    ros.add_argument("--speak-topic", default="/speak")
    ros.add_argument("--say-topic", default="/realtime/say")
    ros.add_argument("--debug-topic", default="/mobipick_gpt/gpt_debug", help="'' to ignore agent progress")
    ros.add_argument("--busy-topic", default="/mobipick_gpt/busy")
    p.add_argument("--mode", choices=["bridge", "agent"], default=os.environ.get("REALTIME_MODE", "bridge"),
                   help="bridge: pass every utterance to mobipick_gpt unfiltered (default); agent: the realtime "
                        "model answers small talk itself and decides what to execute")
    p.add_argument("--no-confirm", action="store_true", default=os.environ.get("REALTIME_CONFIRM", "1") == "0",
                   help="bridge mode: pass utterances on without asking 'Did you say ...?' first")
    p.add_argument("--languages", choices=sorted(LANGUAGE_SETS), default=os.environ.get("REALTIME_LANGUAGES", "en"),
                   help="languages the person may use (default en: English only, the transcription is told to "
                        "expect English); utterances in other languages are ignored")
    p.add_argument("--transcription-hint", default=os.environ.get("REALTIME_TRANSCRIPTION_HINT", TRANSCRIPTION_HINT),
                   help="prompt for the transcription model, e.g. expected object names (default: none)")
    p.add_argument("--push-to-talk", action="store_true", default=os.environ.get("REALTIME_PUSH_TO_TALK", "0") == "1",
                   help="send the mic only while true is published on --talk-topic (e.g. scripts/push_to_talk), so "
                        "during a public demo only the operator is heard (default off)")
    ros.add_argument("--talk-topic", default="/realtime/talk")
    ros.add_argument("--mic-topic", default="/realtime/mic_ok")
    p.add_argument("--dead-mic-s", type=float, default=float(os.environ.get("REALTIME_DEAD_MIC_S", "5")),
                   help="warn when the mic delivers only digital silence (muted) this many seconds (0: never)")
    p.add_argument("--no-dead-mic-say", dest="dead_mic_say", action="store_false",
                   default=os.environ.get("REALTIME_DEAD_MIC_SAY", "1") != "0",
                   help="only log and publish a muted mic, do not say it aloud (at most every 5 min otherwise)")
    p.add_argument("--reconnect-tries", type=int, default=int(os.environ.get("REALTIME_RECONNECT_TRIES", "5")),
                   help="when the realtime session ends (60 min limit, network), open a new one this many times "
                        "before giving up (0: exit at once, the old behaviour)")
    p.add_argument("--silence-watchdog", type=float, default=float(os.environ.get("REALTIME_SILENCE_WATCHDOG_S", "60")),
                   help="after this many seconds without any server event, probe the session and open a new one if "
                        "it does not answer within 15 s (0: off)")
    p.add_argument("--talk-timeout", type=float, default=15.0,
                   help="push-to-talk: the mic closes by itself this many seconds after a true")
    ros.add_argument("--prompt-dir", default=os.environ.get("MOBIPICK_PROMPT_DIR", DEFAULT_PROMPT_DIR))
    p.add_argument("-v", "--verbose", action="store_true")
    return p.parse_args()


class VoiceAgent:
    def __init__(self, args: argparse.Namespace) -> None:
        self.args = args
        self.ros = RosStringBridge(args.rosbridge_url)
        self.engine = make_engine(args)
        url, token = resolve_endpoint(args.backend, args.model, args.litellm_url, args.api_key)
        self.url = url
        self.client = RealtimeClient(url, token)
        self.bridge = args.mode == "bridge"
        if args.instructions_file:
            instructions = open(args.instructions_file).read()
        elif self.bridge:
            instructions = BRIDGE_INSTRUCTIONS
        else:
            instructions = build_instructions(args.prompt_dir)
        self.allowed_languages = LANGUAGE_SETS[args.languages]
        # one allowed language: tell the transcription model to expect it (it only takes a single hint)
        transcription_language = args.language or (
            self.allowed_languages[0] if len(self.allowed_languages) == 1 else "")
        self.session_config = build_session(
            instructions, voice=args.voice,
            tools=None if (args.no_tools or self.bridge) else [MOBIPICK_TOOL],
            vad=args.vad, vad_eagerness=args.vad_eagerness, language=transcription_language,
            create_response=not self.bridge, transcription_model=args.transcription_model,
            transcription_prompt=args.transcription_hint, interrupt_response=args.barge_in == "any")
        self._clock = time.monotonic
        self.engine.mic_watch.dead_after_s = args.dead_mic_s
        self._mic_said_at = float("-inf")  # when the robot last said that its mic is muted
        self._mic_ok_at = float("-inf")    # when /realtime/mic_ok was last published
        self._speaking = False
        self._line_open = False
        self._busy = False
        self._asked_at = 0.0     # when the agents last asked the person a question
        self._pending = ""       # order waiting for the person's yes
        self._pending_at = 0.0
        self._reasked = False    # the order was asked a second time already
        self._said: "list[tuple[float, str]]" = []  # the robot's own recent words, to drop their echo
        self._played_until = 0.0  # when the robot voice last stopped
        self.language = "en"      # the language the person speaks now
        self.voice = VoiceSession(
            self.client, self.engine,
            on_user_text=self._on_user_text,
            on_assistant_delta=self._on_robot_delta,
            on_assistant_text=self._on_robot_text,
            on_tool_call=self._on_tool_call,
            speak_only=self.bridge,
            barge_in=args.barge_in, barge_in_margin_db=args.barge_in_margin_db,
            push_to_talk=args.push_to_talk, talk_timeout_s=args.talk_timeout,
        )
        self.stop = threading.Event()
        self._lost = threading.Event()  # the realtime session ended without our Ctrl-C
        self._probe_at: "float | None" = None  # when the silence watchdog sent its probe
        self.client.on("connection.closed", lambda e: self._lost.set())

    # ---------------------------------------------------------------- person -> agents

    def _on_user_text(self, text: str) -> None:
        if not text:
            return
        self._print(f"you>   {text}")
        self.ros.publish("/realtime/user_transcript", text)
        confirming = self.bridge and not self.args.no_confirm
        if NON_LATIN_RE.search(text) and confirming and self._pending_order():
            self._ask_again(text)  # the yes heard as "いや"
            return
        if not is_speech(text):
            return
        if self.args.transcription_hint and overlaps(text, self.args.transcription_hint, share=0.8, min_words=6):
            self._print("  x  ignored: the transcription hint leaked in")
            return
        # a leak of the robot voice arrives while it plays or right after
        leak_window = self._speaking or self._clock() - self._played_until < 2.0
        if leak_window and any(echoes(text, said) for _, said in self._said):
            self._print("  x  ignored: my own voice")
            return
        if NON_LATIN_RE.search(text):
            self._print("  x  ignored: not in an allowed language (--languages %s)" % self.args.languages)
            return
        detected = detect_language(text, self.language)
        if self.allowed_languages == ["en"] and detected == "en":
            detected = foreign_only(text) or detected
        if detected not in self.allowed_languages:
            self._print(f"  x  ignored: {LANGUAGE_NAMES[detected]} is not allowed (--languages {self.args.languages})")
            return
        language = requested_language(text) or detected
        if language not in self.allowed_languages:
            language = self.language
        if language != self.language:
            self._print(f"  ~  language: {LANGUAGE_NAMES[language]}")
            self.language = language
            self.voice.language = LANGUAGE_NAMES[language]
        if is_stop(text):
            self.voice.interrupt("stop word")  # --barge-in stop: the only way to cut the robot off
        if confirming:
            self._confirm(text)
            return
        if self.bridge or self._busy:
            self._pass_on(text)

    def _confirm(self, text: str) -> None:
        """Read a command back ("Pick the Pringles?") and pass it on only after a yes.

        Chat, questions and answers (no action verb) go straight through, as
        does "stop"; ghost words from noise mostly look like commands
        ("pick", "place"), which is what the confirmation guards against.
        The order waits through other talk (a crowded room): only a yes, a
        no, a new order, a stop or the timeout (``_pending_order``) end it.
        """
        if is_stop(text):
            self._pending = ""
            # the planner misread a lone "cancela" as unclear: give it the English word too
            english = all(STOP_RE.match(w) is None or w in ENGLISH_STOPS for w in words_of(text))
            self._pass_on(text if english else f"stop ({text})")
            return
        pending = self._pending_order()
        if self._pending and not pending:
            self._print(f"  x  dropped unconfirmed: {self._pending}")
            self._pending = ""
        verdict, rest = yes_or_no(text) if pending else ("", text)
        if verdict == "yes":
            if len(words_of(rest)) >= 2 and is_command(rest, self.language) \
                    and set(words_of(rest)) != set(words_of(pending)):
                text = rest  # "yes, pick the sugar box": a new wording, confirm that instead
            else:
                self._pending = ""
                self._pass_on(pending)
                self._say_self(PHRASES[self.language]["yes"])
                return
        elif verdict == "no":
            self._print(f"  x  rejected: {pending}")
            self._pending = ""
            if len(words_of(rest)) < 2 or not is_speech(rest):
                self._say_self(PHRASES[self.language]["no"])
                return
            text = rest  # "no, pick the sugar box": confirm the correction
        elif pending and len(words_of(text)) == 1 and not is_command(text, self.language):
            self._ask_again(text)
            return
        # A lone word is an answer when the agents just asked something
        # ("table 2", "the coke"); otherwise it is mostly noise heard as a
        # word ("soup", "Haha", "Wartość"): dropped, not even confirmed (a
        # lone verb such as "navegar" is a command and still confirmed).
        answering = self._busy and self._clock() - self._asked_at < ANSWER_WINDOW_S
        lone = len(words_of(text)) == 1 and not answering \
            and words_of(text)[0] not in (YES_WORDS - WEAK_YES) | NO_WORDS
        if lone and not is_command(text, self.language):
            self._print(f"  x  ignored lone word: {text}")
            return
        if not is_command(text, self.language):
            self._pass_on(text)  # a question or remark does not cancel a pending order
            return
        self._pending, self._pending_at, self._reasked = as_command(text), self._clock(), False
        self._print(f"  ?  confirm: {self._pending}")
        self._ask(self._pending)

    def _pending_order(self) -> str:
        """The order waiting for a yes, or '' once the person had time to answer and did not."""
        if not self._pending:
            return ""
        now = self._clock()
        quiet_for = now - max(self._pending_at, self._played_until)
        if now - self._pending_at < CONFIRM_MAX_S and (self._speaking or quiet_for < CONFIRM_REPLY_S):
            return self._pending
        return ""

    def _ask_again(self, heard: str) -> None:
        """A stray word while waiting for yes or no: mostly the answer misheard ("sí" as "soup").

        Asked once more; after that such words are ignored, so room talk does
        not make the robot repeat itself.
        """
        if self._reasked:
            self._print(f"  x  ignored, still waiting for yes or no: {heard}")
            return
        self._reasked = True
        self._print(f"  ?  asking again, heard only: {heard}")
        self._ask(self._pending)

    def _ask(self, order: str) -> None:
        phrase = PHRASES[self.language]["confirm"]
        self._say_self(phrase.format(read_back(order, self.language)), own=phrase.format(""))

    def _pass_on(self, text: str) -> None:
        # Idle: a request that starts a workflow. While an order runs: an
        # event for it (mobipick_api's HRI buffers /recognized_speech, the
        # planner reads it with check_for_events() and listen() takes it as
        # an answer; the runner starts no new workflow then).
        self._print(f"  -> {'event' if self._busy else 'request'}: {text}")
        self.ros.publish(self.args.goal_topic, text)

    def _say_self(self, text: str, own: str = "") -> None:
        """Say ``text``; ``own`` is the part that is the robot's own words (the rest quotes the person)."""
        now = self._clock()
        self._said = [(t, s) for t, s in self._said if now - t < 60] + [(now, own or text)]
        self.voice.say(text)

    def _on_tool_call(self, name: str, arguments: dict) -> dict:
        request = str(arguments.get("request", "")).strip()
        if name != MOBIPICK_TOOL["name"] or not request:
            return {"error": f"unknown tool {name} or empty request"}
        if self._busy:
            # the person's own words already went to the running order as an event
            self._print(f"  x  busy, words passed as event instead: {request}")
            return {"status": "you are busy with an order; the person's words already reached it as an event "
                              "(a stop or cancel, new information, or an answer to your question) and it will "
                              "react at its next step. A new order can only start after this one finishes."}
        self._print(f"  -> execute: {request}")
        self.ros.publish(self.args.goal_topic, request)
        return {"status": "started; progress, results and questions will come as [I said] and [status] messages"}

    def _on_busy(self, busy: bool) -> None:
        if busy != self._busy:
            self._busy = busy
            if self.bridge:
                return
            self.voice.note("[status] " + ("I started working on an order; until it is finished everything "
                                           "the person says reaches it directly as an event" if busy else
                                           "I finished my order and can take new orders"))

    def _on_talk(self, on: bool) -> None:
        self.voice.set_talk(on)
        self._print("  ~  mic " + ("open (push-to-talk)" if on else "closed (push-to-talk)"))

    # ---------------------------------------------------------------- agents -> person

    def _on_speak(self, text: str) -> None:
        text = text.strip()
        if not text:
            return
        self._print(f"  <- planner says: {text}")
        if text.rstrip().endswith("?"):
            self._asked_at = self._clock()
        if not self.bridge:
            self.voice.note(f"[I said] {text}")
        self._say_self(text)

    def _on_debug(self, raw: str) -> None:
        try:
            data = json.loads(raw)
        except ValueError:
            return
        if data.get("kind") == "act":
            text = str(data.get("text", "")).strip()
            if text:
                _LOG.info("robot status: %s", text)
                if not self.bridge:
                    self.voice.note(f"[status] {text}")

    def _on_robot_delta(self, delta: str) -> None:
        if not self._line_open:
            print("robot> ", end="", flush=True)
            self._line_open = True
        print(delta, end="", flush=True)

    def _on_robot_text(self, text: str) -> None:
        if self._line_open:
            print(flush=True)
            self._line_open = False
        if text:
            self.ros.publish("/realtime/robot_transcript", text)

    def _print(self, line: str) -> None:
        if self._line_open:
            print(flush=True)
            self._line_open = False
        print(line, flush=True)

    def _watch_speaking(self) -> None:
        while not self.stop.wait(0.1):
            self._watch_mic()
            speaking = self.engine.is_playing()
            if speaking != self._speaking:
                self._speaking = speaking
                if not speaking:
                    self._played_until = self._clock()
                self.ros.publish_bool("/realtime/is_speaking", speaking)

    def _watch_mic(self) -> None:
        """Say so when the microphone delivers only digital silence (a muted ALU1, #189), and when it is back."""
        watch = self.engine.mic_watch
        change = watch.update()
        now = self._clock()
        if change:
            self._print(f"  !  WARNING: the microphone delivers no sound for {watch.silent_s():.0f} s, I hear nothing "
                        "(muted? the ALU1 has a mute button)")
            if self.args.dead_mic_say and now - self._mic_said_at >= DEAD_MIC_SAY_EVERY_S:
                self._mic_said_at = now
                self._say_self(DEAD_MIC_SENTENCE)
        elif change is False:
            self._print("  ~  the microphone delivers sound again")
        if change is not None or now - self._mic_ok_at >= MIC_OK_EVERY_S:
            self._mic_ok_at = now
            self.ros.publish_bool(self.args.mic_topic, not watch.dead)

    # ---------------------------------------------------------------- run

    def run(self) -> int:
        if not connect(self.client, self.url, self.session_config):
            return 1
        self.ros.subscribe(self.args.speak_topic, self._on_speak)
        self.ros.subscribe(self.args.say_topic, self._on_speak)
        if self.args.debug_topic:
            self.ros.subscribe(self.args.debug_topic, self._on_debug)
        if self.args.busy_topic:
            self.ros.subscribe_bool(self.args.busy_topic, self._on_busy)
        if self.args.push_to_talk:
            self.ros.subscribe_bool(self.args.talk_topic, self._on_talk)
            remember_rosbridge_url(self.args.rosbridge_url)
        threading.Thread(target=self._watch_speaking, daemon=True).start()
        if self.args.meter:
            start_meter(self.engine, self.stop)
        print(f"Mobipick voice agent ready (voice {self.args.voice}, echo canceller {self.engine.aec.name}, "
              f"barge-in {self.args.barge_in}). Tasks go to {self.args.goal_topic}, {self.args.speak_topic} is "
              "spoken. Ctrl-C to quit.", flush=True)
        if self.args.push_to_talk:
            print(f"push-to-talk: the mic is closed until true arrives on {self.args.talk_topic} "
                  f"(scripts/push_to_talk, or: rostopic pub -1 {self.args.talk_topic} std_msgs/Bool true); "
                  f"it closes on false or after {self.args.talk_timeout:.0f} s", flush=True)
        self._say_self("Hello, I am Mobipick. How can I help you?")
        return self._serve()

    def _serve(self) -> int:
        """Run until Ctrl-C; open a new realtime session whenever the server ends one (60 min limit, #186)."""
        while not self.stop.is_set():
            if not self._lost.wait(0.5) or self.stop.is_set():
                self._watch_session()
                continue
            self._lost.clear()
            if not self._reconnect():
                return 1
            if not self.client.closed.is_set():
                self._lost.clear()  # closes of failed tries on the way
        return 0

    def _watch_session(self) -> None:
        """#25: the server stopped sending anything while the socket stayed open (only a restart helped). After
        --silence-watchdog seconds without an event, send the session config again (the server answers with
        session.updated); no event within WATCHDOG_PROBE_S closes the socket, and _serve opens a new session."""
        limit = self.args.silence_watchdog
        if limit <= 0 or not self.client.session_ready.is_set():
            self._probe_at = None
            return
        now = self._clock()
        if self._probe_at is None:
            if now - self.client.last_event_at >= limit:
                self._probe_at = now
                self.client.update_session(self.session_config)
        elif self.client.last_event_at >= self._probe_at:
            self._probe_at = None  # it answered
        elif now - self._probe_at >= WATCHDOG_PROBE_S:
            self._probe_at = None
            self._print(f"  ~  realtime session silent for {now - self.client.last_event_at:.0f} s, no answer to a "
                        "probe: closing it")
            self.client.last_error = {"code": "silent_session", "message": "no server event and no answer to a probe"}
            self.client.close()  # connection.closed -> _serve opens a new session

    def _reconnect(self) -> bool:
        """A new session with the same configuration; the audio, ROS topics and language stay as they are."""
        error = self.client.last_error or {}
        reason = error.get("code") or error.get("message") or "connection closed"
        self._probe_at = None
        tries = self.args.reconnect_tries
        for attempt in range(tries):
            if self.stop.wait(RECONNECT_WAIT_S[min(attempt, len(RECONNECT_WAIT_S) - 1)]):
                return False
            self._print(f"  ~  realtime session ended ({reason}): opening a new one, try {attempt + 1}/{tries}")
            try:
                self.client.reconnect()
                if self.client.wait_ready(15):
                    self._print("  ~  new realtime session ready (same voice, language and topics)")
                    return True
                reason = (self.client.last_error or {}).get("message") or "session not ready"
            except Exception as exc:  # handshake refused, proxy down, ...
                reason = str(exc).split(" -+-+- ")[0]
        self._print(f"realtime session ended ({reason}) and no new one could be opened: exiting"
                    if tries else f"realtime session ended ({reason}): exiting (--reconnect-tries 0)")
        return False

    def shutdown(self) -> None:
        self.stop.set()
        self.client.close()
        self.engine.stop()
        save_echo_delay(self.args, self.engine)
        self.ros.close()
        save_debug(self.engine, self.args.debug_dir)


def main() -> int:
    args = parse_args()
    logging.basicConfig(level=logging.DEBUG if args.verbose else logging.INFO,
                        format="%(levelname)s %(name)s: %(message)s")
    for noisy in ("roslibpy", "autobahn", "twisted"):
        logging.getLogger(noisy).setLevel(logging.WARNING)
    try:
        agent = VoiceAgent(args)
    except ConnectionError as exc:
        print(f"{exc}\nIs GPT Robot Demo running? It starts rosbridge on :9090.")
        return 1
    signal.signal(signal.SIGINT, lambda *_: agent.stop.set())
    signal.signal(signal.SIGTERM, lambda *_: agent.stop.set())
    try:
        return agent.run()
    finally:
        agent.shutdown()
        time.sleep(0.2)


if __name__ == "__main__":
    code = main()
    sys.stdout.flush()
    sys.stderr.flush()
    # skip interpreter finalizers: livekit's FFI handles assert while being
    # garbage collected at exit and print a misleading traceback
    os._exit(code)
