SURE_YES = {"yes", "yeah", "yep", "yup", "ya", "yea", "yah", "yeh", "correct", "exactly", "affirmative", "sí", "si",
            "claro", "correcto", "exacto", "ja", "genau", "richtig"}
# a yes only next to another word ("do it", "that's it"); alone mostly a fragment of room talk ("It")
WEAK_YES = {"that", "is", "it", "that's", "do", "ahead", "es", "por", "favor"}
NO_WORDS = {"no", "nope", "nah", "wrong", "negative", "incorrect", "not", "nein", "falsch", "incorrecto"}
# an utterance with one of these verbs asks the robot to act, so it is confirmed first. Matched as
# stems: English with its endings, Spanish in any conjugation (agarra, agarrar, agarraras), German
# also behind a separable prefix (herbringen, abstellen, aufheben).
ACTION_STEMS = {
    "en": ["pick", "place", "put", "insert", "bring", "brought", "take", "took", "grab", "fetch", "carry",
           "transport", "deliver", "move", "go", "drive", "navigate", "come", "return", "turn", "perceive",
           "inspect", "look", "find", "search", "explore", "scan", "check", "open", "close", "drop", "release",
