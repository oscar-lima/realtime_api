# the transcription sometimes returned the hint itself for noise.
TRANSCRIPTION_HINT = ""

FILLER = {"mm", "mhm", "hm", "hmm", "uh", "um", "ah", "eh", "oh", "uh-huh", "mm-hmm"}
# English, Spanish and German, so the person can switch language mid session
STOP_RE = re.compile(r"^(stop\w*|cancel\w*|abort\w*|halt\w*|freeze|para|pare|paren|alto|det[eé]n\w*|stopp\w*|"
                     r"abbrech\w*|abgebrochen|anhalten|aufh[öo]r\w*|schluss)$")
YES_WORDS = {"yes", "yeah", "yep", "yup", "ya", "yea", "yah", "yeh", "correct", "right", "exactly", "sure",
             "affirmative", "ok", "okay", "confirm", "confirmed", "indeed", "go", "do", "please", "that", "is", "it",
             "that's", "ahead", "sí", "si", "claro", "correcto", "vale", "exacto", "eso", "es", "por", "favor", "dale",
