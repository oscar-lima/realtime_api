#!/usr/bin/env python3
"""Talk to the robot through the OpenAI Realtime API (standalone, no ROS).

The robot's answer is played through the speaker by the same process that
captures the microphone, so its own voice is cancelled (WebRTC AEC3 /
Speex / NLMS) and gated before any audio goes back to the API.

Modes:
  (default)      full voice conversation
  --text         type messages, get text answers (checks the API route only)
  --echo-test    no network: play a sample robot sentence and report what the
                 echo canceller + gate would have sent upstream

Examples:
  realtime_voice_demo --list-devices
  realtime_voice_demo --echo-test --output Pebble --input ALU1
  realtime_voice_demo --text
  realtime_voice_demo --input ALU1 --output Pebble
  realtime_voice_demo --backend openai --model gpt-realtime-2.1-mini
"""

import argparse
import logging
import os
import signal
import sys
import threading
import time

import numpy as np

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "src"))

from realtime_api.app import (  # noqa: E402
    add_api_args, add_audio_args, connect, make_engine, save_debug, save_echo_delay, start_meter,
)
from realtime_api.audio_utils import dbfs, read_wav_mono  # noqa: E402
from realtime_api.duplex_audio import FRAME, PROC_RATE  # noqa: E402
from realtime_api.echo_cancel import available_backends  # noqa: E402
from realtime_api.realtime_client import RealtimeClient, build_session, resolve_endpoint  # noqa: E402
from realtime_api.voice_session import DEFAULT_INSTRUCTIONS, ROBOT_COMMAND_TOOL, VoiceSession  # noqa: E402

DATA = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "test", "data")
_LOG = logging.getLogger("realtime_voice_demo")


def parse_args() -> argparse.Namespace:
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--list-devices", action="store_true", help="list audio devices and AEC backends")
    mode = p.add_mutually_exclusive_group()
    mode.add_argument("--text", action="store_true", help="text-only chat over the realtime API")
    mode.add_argument("--echo-test", action="store_true", help="offline echo test, no network")

    add_api_args(p)
    add_audio_args(p)
    p.add_argument("-v", "--verbose", action="store_true")
    return p.parse_args()


# ---------------------------------------------------------------- modes


def run_echo_test(args: argparse.Namespace) -> int:
    """Play robot speech, count how much of it would have reached the API."""
    engine = make_engine(args)
    engine.record_debug = True
    sent_frames = []
    engine.add_frame_callback(lambda frame, info: sent_frames.append((frame, info)))
    voice, _ = read_wav_mono(os.path.join(DATA, "robot_voice_16k.wav"), PROC_RATE)
    mark = len(engine.debug_mic)
    time.sleep(0.5)
    sent_frames.clear()
    print(f"playing {voice.size / PROC_RATE:.1f} s of robot speech; stay quiet ...", flush=True)
    engine.play(voice, PROC_RATE, "echo-test")
    while engine.is_playing():
        time.sleep(0.1)
    time.sleep(0.8)
    engine.stop()
    mic = np.concatenate(engine.debug_mic[mark:])
    out = np.concatenate(engine.debug_out[mark:])
    ref = np.concatenate(engine.debug_ref[mark:])
    on = np.array([np.sqrt(np.mean(ref[i:i + FRAME].astype(float) ** 2)) > 100 for i in range(0, ref.size, FRAME)])
    echo = np.repeat(on, FRAME)[: mic.size]
    passed = sum(1 for f, info in sent_frames if info["echo_active"] and np.any(f))
    total = sum(1 for _, info in sent_frames if info["echo_active"])
    erle = dbfs(mic[echo]) - dbfs(out[echo]) if echo.any() else float("nan")
    print()
    print(f"AEC backend        : {engine.aec.name}   gate: {engine.gate.mode}")
    print(f"mic during speech  : {dbfs(mic[echo]):.1f} dBFS   after AEC: {dbfs(out[echo]):.1f} dBFS")
    print(f"echo removed (ERLE): {erle:.1f} dB")
    print(f"frames sent upstream while the robot spoke: {passed}/{total} "
          f"({100.0 * passed / max(total, 1):.1f}%, 0% = the API never hears the robot)")
    if args.debug_dir:
        save_debug(engine, args.debug_dir)
    return 0


def run_text(args: argparse.Namespace) -> int:
    url, token = resolve_endpoint(args.backend, args.model, args.litellm_url, args.api_key)
    client = RealtimeClient(url, token)
    session = build_session(load_instructions(args), tools=None if args.no_tools else [ROBOT_COMMAND_TOOL],
                            audio=False)
    done = threading.Event()
    VoiceSession(client, None,
                 on_assistant_delta=lambda d: print(d, end="", flush=True),
                 on_assistant_text=lambda t: print(),
                 on_tool_call=dry_tool)
    def on_done(event: dict) -> None:
        print_usage(event)
        outputs = (event.get("response") or {}).get("output", [])
        if not any(o.get("type") == "function_call" for o in outputs):
            done.set()  # a tool call is followed by a second response

    client.on("response.done", on_done)
    client.on("error", lambda e: done.set())
    client.on("connection.closed", lambda e: done.set())
    if not connect(client, url, session):
        return 1
    print("connected. Type a message (Ctrl-D to quit).")
    try:
        for line in sys.stdin:
            if not line.strip():
                continue
            done.clear()
            print("robot> ", end="", flush=True)
            client.send_text(line.strip())
            done.wait(60)
            if client.closed.is_set():
                return 1
    finally:
        client.close()
    return 0


def run_voice(args: argparse.Namespace) -> int:
    url, token = resolve_endpoint(args.backend, args.model, args.litellm_url, args.api_key)
    engine = make_engine(args)
    client = RealtimeClient(url, token)
    session = build_session(load_instructions(args), voice=args.voice,
                            tools=None if args.no_tools else [ROBOT_COMMAND_TOOL],
                            vad=args.vad, vad_eagerness=args.vad_eagerness, language=args.language,
                            transcription_model=args.transcription_model)
    state = {"speaking": False}

    def assistant_delta(delta: str) -> None:
        if not state["speaking"]:
            print("robot> ", end="", flush=True)
            state["speaking"] = True
        print(delta, end="", flush=True)

    def assistant_done(_: str) -> None:
        state["speaking"] = False
        print(flush=True)

    def user_text(text: str) -> None:
        if text:  # may arrive while the robot's answer is still streaming
            print(("\n" if state["speaking"] else "") + f"you>   {text}", flush=True)
            if state["speaking"]:
                print("robot> ...", end="", flush=True)

    VoiceSession(client, engine,
                 on_user_text=user_text,
                 on_assistant_delta=assistant_delta, on_assistant_text=assistant_done,
                 on_tool_call=dry_tool)
    client.on("input_audio_buffer.speech_started", lambda e: _LOG.debug("user speech started"))
    client.on("response.done", print_usage if args.verbose else (lambda e: None))
    stop = threading.Event()
    client.on("connection.closed", lambda e: stop.set())
    signal.signal(signal.SIGINT, lambda *_: stop.set())
    try:
        if not connect(client, url, session):
            return 1
        print("listening. Talk to the robot (Ctrl-C to quit).", flush=True)
        if args.meter:
            start_meter(engine, stop)
        stop.wait()
    finally:
        client.close()
        engine.stop()
        save_echo_delay(args, engine)
        save_debug(engine, args.debug_dir)
    return 0


# ---------------------------------------------------------------- helpers


def load_instructions(args: argparse.Namespace) -> str:
    if args.instructions_file:
        with open(args.instructions_file) as handle:
            return handle.read()
    return DEFAULT_INSTRUCTIONS


def dry_tool(name: str, arguments: dict) -> dict:
    print(f"\n  [tool] {name}({arguments})  -> dry run, mobipick_gpt not connected", flush=True)
    return {"status": "accepted", "note": "dry run: the task planner is not connected yet, "
            "tell the user the command was understood"}


def print_usage(event: dict) -> None:
    usage = (event.get("response") or {}).get("usage") or {}
    status = (event.get("response") or {}).get("status")
    if status and status != "completed":
        print(f"  [response {status}: {(event.get('response') or {}).get('status_details')}]", flush=True)
    if usage:
        print(f"  [tokens in {usage.get('input_tokens')} out {usage.get('output_tokens')}]", flush=True)


def main() -> int:
    args = parse_args()
    logging.basicConfig(level=logging.DEBUG if args.verbose else logging.INFO,
                        format="%(levelname)s %(name)s: %(message)s")
    if args.list_devices:
        import sounddevice as sd

        print(sd.query_devices())
        print("\nAEC backends:", available_backends())
        return 0
    if args.echo_test:
        return run_echo_test(args)
    if args.text:
        return run_text(args)
    return run_voice(args)


if __name__ == "__main__":
    sys.exit(main())
